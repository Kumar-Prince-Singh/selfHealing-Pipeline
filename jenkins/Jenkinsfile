pipeline {
    agent any
    
    environment {
        APP_NAME = 'self-healing-app'
        DOCKER_IMAGE = "ram9219/self-healing-app"
    }
    
    stages {
        
        stage('🎯 Clone Repository') {
            steps {
                echo "Cloning repository from GitHub..."
                retry(2) {
                    git branch: 'main', 
                        url: 'https://github.com/Ram9219/self-healing-pipeline.git'
                }
                echo "✅ Repository cloned successfully!"
            }
        }
        
        stage('🐳 Build Docker Image with Retry') {
            steps {
                script {
                    echo "Building Docker image..."
                    bat """
                        set MAX_RETRIES=3
                        setlocal enabledelayedexpansion
                        for /l %%i in (1,1,!MAX_RETRIES!) do (
                            echo Build attempt %%i of !MAX_RETRIES!
                            docker build -t %DOCKER_IMAGE%:latest ./app
                            if !errorlevel! equ 0 (
                                echo Build succeeded on attempt %%i!
                                goto :build_success
                            ) else (
                                echo Build attempt %%i failed
                                if %%i equ !MAX_RETRIES! (
                                    echo All !MAX_RETRIES! attempts exhausted!
                                    exit /b 1
                                )
                                echo Retrying in 5 seconds...
                                timeout /t 5 /nobreak >nul
                            )
                        )
                        :build_success
                    """
                }
            }
        }
        
        stage('🧪 Run Tests with Self-Healing') {
            steps {
                script {
                    echo "Starting container for testing..."
                    bat """
                        docker run -d --name test-%APP_NAME% -p 8080:5000 %DOCKER_IMAGE%:latest
                        timeout /t 5 /nobreak >nul
                    """
                    
                    echo "Running health tests with retry..."
                    def testResult = bat(
                        script: """
                            for /l %%i in (1,1,3) do (
                                echo Test attempt %%i of 3
                                curl -f http://localhost:8080/health
                                if !errorlevel! equ 0 exit /b 0
                                echo Attempt %%i failed, waiting...
                                timeout /t 3 /nobreak >nul
                            )
                            echo All test attempts failed!
                            exit /b 1
                        """,
                        returnStatus: true
                    )
                    
                    if (testResult != 0) {
                        echo "⚠️ Tests failed after automatic retries. Pipeline marked UNSTABLE but continuing..."
                        currentBuild.result = 'UNSTABLE'
                    } else {
                        echo "✅ All tests passed!"
                    }
                    
                    bat("docker stop test-%APP_NAME% || true")
                    bat("docker rm test-%APP_NAME% || true")
                }
            }
        }
        
        stage('📤 Push to Docker Hub') {
            steps {
                echo "Pushing image to Docker Hub..."
                retry(2) {
                    withDockerRegistry([credentialsId: 'docker-hub-credentials', url: 'https://index.docker.io/v1/']) {
                        bat "docker push %DOCKER_IMAGE%:latest"
                    }
                }
                echo "✅ Image pushed successfully to Docker Hub!"
            }
        }
        
        stage('🚀 Deploy with Rollback') {
            steps {
                script {
                    echo "Saving current image version for rollback..."
                    bat """
                        echo %DOCKER_IMAGE%:latest > last_successful_image.txt
                        docker-compose down || true
                        docker-compose up -d
                    """
                    echo "✅ Deployment complete!"
                }
            }
        }
        
        stage('🩺 Health Check & Auto-Healing') {
            steps {
                script {
                    echo "Waiting for container to stabilize..."
                    timeout(time: 60, unit: 'SECONDS') {
                        def healthStatus = bat(
                            script: """
                                timeout /t 10 /nobreak >nul
                                for /l %%i in (1,1,3) do (
                                    echo Health check attempt %%i
                                    curl -f http://localhost:5000/health
                                    if !errorlevel! equ 0 exit /b 0
                                    timeout /t 5 /nobreak >nul
                                )
                                echo Container is unhealthy!
                                exit /b 1
                            """,
                            returnStatus: true
                        )
                        
                        if (healthStatus != 0) {
                            echo "⚠️⚠️⚠️ HEALTH CHECK FAILED! Initiating AUTO-ROLLBACK... ⚠️⚠️⚠️"
                            bat """
                                echo 🔄 Rolling back to previous version...
                                docker-compose down
                                docker-compose up -d
                                echo ✅ Rollback completed! Previous version is now running.
                            """
                            currentBuild.result = 'UNSTABLE'
                        } else {
                            echo "✅ Container is healthy! No rollback needed."
                        }
                    }
                }
            }
        }
    }
    
    post {
        failure {
            echo """
            ┌─────────────────────────────────────────────────────────┐
            │  ❌ PIPELINE FAILED ❌                                   │
            │                                                          │
            │  Self-healing attempted but all retries exhausted.      │
            │  Check Jenkins console for details.                      │
            └─────────────────────────────────────────────────────────┘
            """
        }
        
        unstable {
            echo """
            ┌─────────────────────────────────────────────────────────┐
            │  ⚠️ PIPELINE COMPLETED WITH WARNINGS ⚠️                 │
            │                                                          │
            │  Self-healing was triggered and pipeline recovered.     │
            │  Review the logs for details.                           │
            └─────────────────────────────────────────────────────────┘
            """
        }
        
        success {
            echo """
            ┌─────────────────────────────────────────────────────────┐
            │  ✅ SELF-HEALING PIPELINE SUCCEEDED! ✅                 │
            │                                                          │
            │  All stages completed successfully.                     │
            │  Application is running on http://localhost:5000        │
            └─────────────────────────────────────────────────────────┘
            """
        }
    }
}