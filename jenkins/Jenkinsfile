pipeline {
    agent any
    
    environment {
        APP_NAME = 'self-healing-app'
        DOCKER_IMAGE = "ram9219/self-healing-app"
    }
    
    stages {
        
        stage('🎯 Clone Repository') {
            steps {
                echo "Cloning repository from GitHub..."
                retry(2) {
                    git branch: 'main', 
                        url: 'https://github.com/Ram9219/self-healing-pipeline.git'
                }
                echo "✅ Repository cloned successfully!"
            }
        }
        
        stage('🐳 Build Docker Image with Retry') {
            steps {
                script {
                    echo "Building Docker image..."
                    retry(3) {
                        bat "docker build -t %DOCKER_IMAGE%:latest ./app"
                        // Small delay between retries (Windows compatible)
                        bat "ping -n 2 127.0.0.1 > nul"
                    }
                    echo "✅ Build completed!"
                }
            }
        }
        
        stage('🧪 Run Tests with Self-Healing') {
            steps {
                script {
                    echo "Cleaning up any existing test container..."
                    bat "docker stop test-%APP_NAME% 2>nul || echo no-container-to-stop"
                    bat "docker rm test-%APP_NAME% 2>nul || echo no-container-to-remove"
                    
                    echo "Starting container for testing on port 9090..."
                    bat "docker run -d --name test-%APP_NAME% -p 9090:5000 %DOCKER_IMAGE%:latest"
                    bat "ping -n 6 127.0.0.1 > nul"
                    
                    echo "Running health tests with retry..."
                    def testResult = 1
                    for (int i = 1; i <= 3; i++) {
                        echo "Test attempt ${i} of 3"
                        testResult = bat(script: "curl -f http://localhost:9090/health", returnStatus: true)
                        if (testResult == 0) {
                            break
                        }
                        echo "Attempt ${i} failed, waiting..."
                        bat "ping -n 4 127.0.0.1 > nul"
                    }

                    if (testResult != 0) {
                        echo "⚠️ Tests failed after automatic retries. Pipeline marked UNSTABLE but continuing..."
                        currentBuild.result = 'UNSTABLE'
                    } else {
                        echo "✅ All tests passed!"
                    }

                    bat "docker stop test-%APP_NAME% 2>nul || echo no-container-to-stop"
                    bat "docker rm test-%APP_NAME% 2>nul || echo no-container-to-remove"
                }
            }
        }
        
        stage('📤 Push to Docker Hub') {
            steps {
                echo "Pushing image to Docker Hub..."
                retry(2) {
                    withDockerRegistry([credentialsId: 'ram9219', url: 'https://index.docker.io/v1/']) {
                        bat "docker push %DOCKER_IMAGE%:latest"
                    }
                }
                echo "✅ Image pushed successfully to Docker Hub!"
            }
        }
        
        stage('🚀 Deploy with Rollback') {
            steps {
                script {
                    echo "Deploying application..."
                    bat "docker-compose -f docker-compose.yml down 2>nul || echo compose-down-failed"
                    bat "docker-compose -f docker-compose.yml up -d"
                    echo "✅ Deployment complete!"
                }
            }
        }
        
        stage('🩺 Health Check & Auto-Healing') {
            steps {
                script {
                    echo "Waiting for container to stabilize..."
                    timeout(time: 60, unit: 'SECONDS') {
                        bat "ping -n 11 127.0.0.1 > nul"
                        def healthStatus = 1
                        for (int i = 1; i <= 3; i++) {
                            echo "Health check attempt ${i}"
                            healthStatus = bat(script: "curl -f http://localhost:5000/health", returnStatus: true)
                            if (healthStatus == 0) {
                                break
                            }
                            bat "ping -n 6 127.0.0.1 > nul"
                        }

                        if (healthStatus != 0) {
                            echo "⚠️⚠️⚠️ HEALTH CHECK FAILED! Initiating AUTO-ROLLBACK... ⚠️⚠️⚠️"
                            bat """
                                echo 🔄 Rolling back to previous version...
                                docker-compose down
                                docker-compose up -d
                                echo ✅ Rollback completed!
                            """
                            currentBuild.result = 'UNSTABLE'
                        } else {
                            echo "✅ Container is healthy!"
                        }
                    }
                }
            }
        }
    }
    
    post {
        failure {
            echo """
            ┌─────────────────────────────────────────────────────────┐
            │  ❌ PIPELINE FAILED ❌                                   │
            └─────────────────────────────────────────────────────────┘
            """
        }
        success {
            echo """
            ┌─────────────────────────────────────────────────────────┐
            │  ✅ SELF-HEALING PIPELINE SUCCEEDED! ✅                 │
            │                                                          │
            │  Application running on http://localhost:5000           │
            └─────────────────────────────────────────────────────────┘
            """
        }
    }
}